{
  "name": "@erinwangstudio-art/dsh-trafficlight",
  "description": "Fork of dsh-trafficlight for DSH Desktop: per-session traffic-light states, a macOS floating overlay with native Liquid Glass, a dockable in-page sidebar twin, subscribed-session navigation, real conversation titles, persisted settings, and drawn resize affordances.",
  "version": "0.4.0-fork.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build:host": "tsc -p tsconfig.host.json",
    "build:client": "tsdown --config tsdown.config.ts",
    "build": "npm run build:host && npm run build:client",
    "typecheck": "tsc -b --pretty false",
    "prepublishOnly": "npm run build",
    "overlay:build": "bash overlay/build.sh",
    "overlay:start": "bash scripts/trafficlight.sh"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "overlay",
    "traffic-light",
    "status",
    "macos",
    "cordis-plugin",
    "dsh-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.1",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "src",
    "overlay",
    "scripts",
    "docs",
    "mock-bridge.mjs",
    "cordis.patch.yml",
    "README.md",
    "FORK-NOTES.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/erinwangstudio-art/dsh-trafficlight.git"
  },
  "homepage": "https://github.com/erinwangstudio-art/dsh-trafficlight#readme",
  "bugs": {
    "url": "https://github.com/erinwangstudio-art/dsh-trafficlight/issues"
  },
  "license": "MIT"
}
